# ==============================================================================
# ShopNest Ethiopia - Global Environment Configuration Reference
# Duplicate this file to .env in root or corresponding sub-packages.
# NEVER commit actual secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Configuration (server/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Database Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/shopnest_ethiopia?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/shopnest_ethiopia

# JWT & Authentication Secrets (minimum 32 characters for production)
JWT_SECRET=super_secret_jwt_signing_key_replace_for_production_min_32_chars
JWT_EXPIRES_IN=7d

# Logging & Monitoring
LOG_LEVEL=info

# Notification Gateway: Telegram Bot & SMS Provider
# Create a bot with @BotFather on Telegram to get your TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_TOKEN=
# Optional default Telegram chat ID for admin notifications (obtain via @userinfobot)
TELEGRAM_DEFAULT_CHAT_ID=
# SMS Provider: 'mock' (default for dev/test) | 'africastalking' | 'twilio' | 'generic_http'
SMS_PROVIDER=mock
# SMS API credentials (required if provider != 'mock')
SMS_API_KEY=
SMS_SENDER_ID=ShopNestET
# Required if SMS_PROVIDER='generic_http' (e.g. Ethio Telecom HTTP gateway endpoint)
SMS_API_URL=

# AI Shopping Assistant Configuration
# Provider: 'mock' (default for dev/test) | 'gemini' | 'openai'
AI_PROVIDER=mock
# Real AI Provider API Key (never exposed to React client)
AI_API_KEY=
# LLM Model Name (e.g. 'gemini-1.5-flash', 'gemini-2.0-flash', 'gpt-4o-mini')
AI_MODEL=gemini-1.5-flash
# Mock Mode: Set to 'true' to use simulated local responses with zero API costs
AI_MOCK_MODE=true
# AI Request Timeout in milliseconds
AI_REQUEST_TIMEOUT_MS=15000
# Maximum output generation tokens
AI_MAX_OUTPUT_TOKENS=1000
# Rate limit: Max assistant requests per 15-minute window per IP
AI_RATE_LIMIT_MAX=30

# ------------------------------------------------------------------------------
# Client Configuration (client/.env)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_NAME=ShopNest Ethiopia
VITE_DEFAULT_LANGUAGE=en
