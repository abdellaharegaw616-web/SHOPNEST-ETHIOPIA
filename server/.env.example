# ==============================================================================
# ShopNest Ethiopia - Backend Environment Configuration
# ==============================================================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas or local connection string
MONGODB_URI=mongodb://localhost:27017/shopnest_ethiopia

# JWT Authentication Secret (min 32 characters)
JWT_SECRET=super_secret_jwt_signing_key_replace_for_production_min_32_chars
JWT_EXPIRES_IN=7d

# Logging configuration (debug, info, warn, error)
LOG_LEVEL=info

# ==============================================================================
# AI Shopping Assistant Configuration
# ==============================================================================
# AI Provider: 'mock' (default for dev/test) | 'gemini' | 'openai'
AI_PROVIDER=mock
# Real AI Provider API Key (Required if AI_MOCK_MODE=false; never expose to client)
AI_API_KEY=
# LLM Model Name (e.g. 'gemini-1.5-flash', 'gemini-2.0-flash', 'gpt-4o-mini')
AI_MODEL=gemini-1.5-flash
# Mock Mode: Set to 'true' to use simulated local responses with zero API costs
AI_MOCK_MODE=true
# AI Provider Request Timeout in milliseconds (default: 15000 = 15 seconds)
AI_REQUEST_TIMEOUT_MS=15000
# Maximum output generation tokens (default: 1000)
AI_MAX_OUTPUT_TOKENS=1000
# Assistant IP Rate Limit per 15-minute window (default: 30 requests)
AI_RATE_LIMIT_MAX=30
