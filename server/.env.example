# ==============================================================================
# ShopNest Ethiopia - Backend Environment Configuration
# ==============================================================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas or local connection string
MONGODB_URI=mongodb://localhost:27017/shopnest_ethiopia

# JWT Authentication Secret (min 32 characters)
JWT_SECRET=super_secret_jwt_signing_key_replace_for_production_min_32_chars
JWT_EXPIRES_IN=7d

# Logging configuration (debug, info, warn, error)
LOG_LEVEL=info
